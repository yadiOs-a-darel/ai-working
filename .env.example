# ── LLM ──────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_FALLBACK_MODEL=phi3.5

# OpenAI (optionnel — fallback cloud)
OPENAI_API_KEY=sk-...

# Anthropic Claude (optionnel)
ANTHROPIC_API_KEY=sk-ant-...

# ── STT ──────────────────────────────────────────────
WHISPER_MODEL_SIZE=small
# Options : tiny, base, small, medium, large-v3
WHISPER_DEVICE=cpu
# Options : cpu, cuda (si GPU NVIDIA disponible)
WHISPER_COMPUTE_TYPE=int8
# Options : int8, float16 (float16 requiert GPU)
WHISPER_LANGUAGE=fr

# ── TTS ──────────────────────────────────────────────
TTS_ENGINE=edge
# Options : edge, coqui, elevenlabs, pyttsx3
TTS_VOICE=fr-FR-HenriNeural
# Autres voix edge-tts FR : fr-FR-DeniseNeural, fr-BE-CharlineNeural
SPEAK_RESPONSES=true
# Lire les réponses à voix haute (mode texte, interface web, etc.)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ── WAKE WORD ─────────────────────────────────────────
WAKE_WORD=hey jarvis
WAKE_WORD_SENSITIVITY=0.5
# Entre 0.0 (permissif) et 1.0 (strict)

# ── AUDIO ─────────────────────────────────────────────
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_DURATION=0.5
VAD_SILENCE_THRESHOLD=0.5
# Secondes de silence avant fin d'enregistrement
MIC_DEVICE_INDEX=-1
# -1 = microphone par défaut

# ── MEMORY ────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma_db
MAX_CONVERSATION_HISTORY=20
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── TOOLS ─────────────────────────────────────────────
TAVILY_API_KEY=tvly-...
OPENWEATHER_API_KEY=
GOOGLE_CALENDAR_CREDENTIALS_PATH=./config/google_credentials.json

# ── API & UI ──────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
UI_PORT=7860
LOG_LEVEL=INFO
LOG_FILE=./data/logs/jarvis.log

# ── IDENTITÉ ──────────────────────────────────────────
JARVIS_NAME=YadjiOs
USER_NAME=Darel
USER_LOCATION=Bangui, République Centrafricaine
USER_LANGUAGE=fr
